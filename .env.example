# Copy this file to .env, then replace the placeholders. Never commit .env.

# Default: a local SQLite file (no database server needed).
DATABASE_URL=sqlite:///./blogging_platform.db
# PostgreSQL instead (see README):
# DATABASE_URL=postgresql+psycopg://blog_user:YOUR_PASSWORD@localhost:5432/blogging_platform

# REQUIRED. The app refuses to start with a missing, short or placeholder secret.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-generated-secret

ACCESS_TOKEN_EXPIRE_MINUTES=30
